<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.29797979797979796"
           maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="400.0"
           prefWidth="600.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controlador.LoginController">

    <items>

        <AnchorPane minHeight="0.0"
                    minWidth="0.0"
                    prefHeight="397.0"
                    prefWidth="243.0"
                    style="-fx-background-color: #277DF5;">

            <children>

                <Label fx:id="tituloMP"
                       layoutX="21.0"
                       layoutY="129.0"
                       text="Registro Escolar">

                    <font>
                        <Font name="Roboto Bold" size="18.0"/>
                    </font>

                </Label>

            </children>

        </AnchorPane>

        <AnchorPane minHeight="0.0"
                    minWidth="0.0"
                    prefHeight="377.0"
                    prefWidth="373.0">

            <children>

                <Label fx:id="tituloIS"
                       layoutX="155.0"
                       layoutY="49.0"
                       text="Iniciar sesión">

                    <font>
                        <Font name="Roboto" size="18.0"/>
                    </font>

                </Label>

                <Label fx:id="lblUsuario"
                       layoutX="46.0"
                       layoutY="111.0"
                       text="Usuario:"
                       textFill="#031e44">

                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>

                </Label>

                <Label layoutX="46.0"
                       layoutY="220.0"
                       prefHeight="23.0"
                       prefWidth="72.0"
                       text="Contraseña:"
                       textFill="#031e44">

                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>

                </Label>

                <TextField fx:id="txtUsuario" onAction="#eventButton"
                           layoutX="47.0"
                           layoutY="137.0"
                           prefHeight="25.0"
                           prefWidth="321.0"
                           style="-fx-background-color: #BBD6FC; -fx-border-radius: 5px;"/>

                <PasswordField fx:id="txtContraseña" onAction="#eventButton"
                               layoutX="47.0"
                               layoutY="258.0"
                               prefHeight="25.0"
                               prefWidth="321.0"
                               style="-fx-background-color: #BBD6FC; -fx-border-radius: 5px;"/>

                <Label fx:id="lblError"
                       layoutX="47.0"
                       layoutY="290.0"
                       textFill="#C62828"/>

                <Button fx:id="btnIniciar"
                        layoutX="182.0"
                        layoutY="321.0"
                        mnemonicParsing="false"
                        onAction="#eventButton"
                        style="-fx-border-radius: 12px;"
                        text="Iniciar">

                    <font>
                        <Font name="Roboto Medium" size="12.0"/>
                    </font>

                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>

                </Button>

            </children>

        </AnchorPane>

    </items>

</SplitPane>