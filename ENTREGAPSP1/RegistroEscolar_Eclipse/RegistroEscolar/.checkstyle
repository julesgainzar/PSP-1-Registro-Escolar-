<?xml version="1.0" encoding="UTF-8"?>
<fileset-config file-format-version="1.2.0" simple-config="false">
  <local-check-config name="RegistroEscolar" location="/RegistroEscolar/checkstyle.xml" type="project" description="Reglas de estilo del proyecto">
    <additional-data name="protect-config-file" value="false"/>
  </local-check-config>
  <fileset name="Codigo fuente" enabled="true" check-config-name="RegistroEscolar" local="true">
    <file-match-pattern match-pattern="^src/main/java/.*\.java$" include-pattern="true"/>
  </fileset>
</fileset-config>
